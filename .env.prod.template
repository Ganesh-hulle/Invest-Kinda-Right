# ==========================================================
# Invest Kinda Right — Production Environment Configuration
# Copy this file to .env.prod on your EC2 server:
#   cp .env.prod.template .env.prod
# DO NOT COMMIT .env.prod TO GIT
# ==========================================================

# ── Database (PostgreSQL) ──
DB_NAME=ikr
DB_USERNAME=ikr_admin
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_20_CHARS

# ── Redis ──
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_20_CHARS

# ── JWT Security ──
# Generate on EC2 using: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_64_CHAR_SECRET
JWT_EXPIRATION=PT24H

# ── Zerodha Kite Connect ──
KITE_API_KEY=your_zerodha_api_key
KITE_API_SECRET=your_zerodha_api_secret
KITE_REDIRECT_URL=http://YOUR_ELASTIC_IP/api/v1/kite/callback
# Generate on EC2 using: openssl rand -hex 16
KITE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_HEX_KEY

# ── CORS & WebSocket ──
WEBSOCKET_ALLOWED_ORIGINS=*
